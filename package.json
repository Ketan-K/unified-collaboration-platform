{
  "name": "unified-collaboration-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "server/*",
    "shared/*"
  ],
  "scripts": {
    "web": "npm run dev --prefix apps/web",
    "desktop": "npm run dev --prefix apps/desktop",
    "admin": "npm run dev --prefix apps/admin",
    "api": "npm run dev --prefix server/api",
    "signaling": "npm run dev --prefix server/signaling",
    "ai-services": "npm run dev --prefix server/ai-services",
    "dev": "npm-run-all --parallel web api signaling",
    "clean": "rimraf apps/*/node_modules server/*/node_modules shared/*/node_modules node_modules"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5"
  }
}