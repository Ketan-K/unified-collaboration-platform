# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage

# next.js
/.next/
**/.next/
/out/
**/out/

# production
/build
**/build
/dist
**/dist

# misc
.DS_Store
*.pem
**/.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/.env*
!**/.env.example

# vercel
.vercel
**/.vercel

# typescript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# IDE/editor specific files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vs/
**/.vs/

# Logs
logs
**/logs
*.log
**/*.log

# Cache directories
.cache/
**/.cache/
.eslintcache
**/.eslintcache
